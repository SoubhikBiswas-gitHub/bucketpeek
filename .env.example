# Signs the session cookie that holds your AWS keys. Required in production, 32+ characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Development only: serve a local folder as if it were a bucket. Any credentials connect.
# LENS_MOCK_DIR=./fixtures/bucket

# Optional: path to ffmpeg if it isn't on PATH. Enables playback of avi, mpeg, ts, wmv and other formats.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Server log detail: debug, info, warn, error or silent. Default: info in production, debug otherwise.
# LOG_LEVEL=info
